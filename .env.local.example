# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use ONE of the following (newer Supabase projects use PUBLISHABLE_KEY):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Service-role key — Project Settings → API → "service_role" (secret).
# Required for the scan worker to write snapshots/alerts past RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Sentinel Hub on Copernicus Data Space — currently DISABLED. Pipeline now
# uses MapTiler (see below). Re-enable by uncommenting the matching code in
# src/lib/sentinel-hub.ts and src/lib/scan.ts.
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=

# MapTiler — used to bake a sharp sub-meter satellite snapshot of each parcel
# (visual context only; not used for change detection). Free tier: 100k tile
# requests/month. https://cloud.maptiler.com → Account → Keys
MAPTILER_API_KEY=

# Vercel Cron secret. Set this in Vercel project env to require Bearer auth
# on /api/cron/scan. Vercel automatically attaches it when invoking the cron.
CRON_SECRET=

# Notifications. The system tries Gmail SMTP first, then Resend, then a
# console-log fallback. Pick whichever you can set up most easily.
#
# Option A — Gmail SMTP (recommended; no domain needed, ~500/day free).
#   1. Enable 2-step verification on your Google account.
#   2. Create an "App password" at https://myaccount.google.com/apppasswords
#   3. Paste it below (it's a 16-char string, spaces ok).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B — Resend (requires verified domain to send to anyone other than
# your own Resend-account email).
RESEND_API_KEY=

# Optional override of the From address. Defaults to your Gmail (Option A)
# or Resend's sandbox sender (Option B).
ALERT_FROM_EMAIL=

# Public origin used in alert email links (defaults to localhost:3000).
NEXT_PUBLIC_APP_URL=
TELEGRAM_BOT_TOKEN=
