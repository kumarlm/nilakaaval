# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use ONE of the following (newer Supabase projects use PUBLISHABLE_KEY):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Service-role key — Project Settings → API → "service_role" (secret).
# Required for the scan worker to write snapshots/alerts past RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Sentinel Hub on Copernicus Data Space — currently DISABLED. Pipeline now
# uses MapTiler (see below). Re-enable by uncommenting the matching code in
# src/lib/sentinel-hub.ts and src/lib/scan.ts.
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=

# MapTiler — used to bake a sharp sub-meter satellite snapshot of each parcel
# (visual context only; not used for change detection). Free tier: 100k tile
# requests/month. https://cloud.maptiler.com → Account → Keys
MAPTILER_API_KEY=

# Vercel Cron secret. Set this in Vercel project env to require Bearer auth
# on /api/cron/scan. Vercel automatically attaches it when invoking the cron.
CRON_SECRET=

# Notifications — alerts are emailed via Resend (https://resend.com).
# Sign up free, get an API key, paste below. Without a key the system still
# detects changes and creates alert rows; emails are just skipped (and logged
# to the server console for debugging).
RESEND_API_KEY=
# Optional override — must be a verified Resend sender domain. Defaults to
# Resend's "onboarding@resend.dev" sandbox sender, which only delivers to
# emails registered with your Resend account.
ALERT_FROM_EMAIL=

# Public origin used in alert email links (defaults to localhost:3000).
NEXT_PUBLIC_APP_URL=
TELEGRAM_BOT_TOKEN=
